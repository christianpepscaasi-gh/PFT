{
  "name": "pocket-ledger",
  "version": "1.0.0",
  "description": "Pocket Ledger finance tracker",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch server.js --watch src server.js",
    "check": "eslint .",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js --unit",
    "test:browser": "node scripts/run-browser-tests.js",
