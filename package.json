    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "mongoose": "^8.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "nodemon": "^3.1.7",
    "playwright-core": "^1.64.1",
    "supertest": "^7.0.0"
  }
